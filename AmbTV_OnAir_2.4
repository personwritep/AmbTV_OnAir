            '.com-tv-TVScreen__NowOnAirController-overlay { height: 60px; } '+
            '.com-tv-NowOnAirController__button:first-child { display: none; }  '+
            '.com-tv-NowOnAirController__button { '+
            'position: absolute; bottom: -62px; right: 168px; z-index: 1; } '+
